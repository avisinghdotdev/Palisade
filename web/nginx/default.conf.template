# Vite names every bundle by its content hash, so a cached copy can never go stale.
# Prerendered HTML and root files keep fixed names, so browsers must revalidate them.
map $uri $cache_control {
  ~^/assets/ "public, max-age=31536000, immutable";
  default "no-cache";
}

server {
  listen 8080;
  server_tokens off;
  absolute_redirect off;
  root /srv/www;
  charset utf-8;
  log_not_found off;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # add_header in a location block discards server-level headers, so every header lives here.
  add_header Cache-Control $cache_control;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # React Router inlines its hydration scripts, so script-src needs 'unsafe-inline' until hashes are generated per build.
  # Cloudflare injects its Web Analytics beacon, which loads from and posts to the two cloudflareinsights hosts.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

  # API_UPSTREAM is substituted at container start; the API owns the /api prefix.
  # ^~ keeps the file-name rule below from claiming API paths that end in an extension.
  location ^~ /api/ {
    proxy_pass http://${API_UPSTREAM};
  }

  # The platform's health probes, every few seconds, so they stay out of the access log.
  location = /health {
    access_log off;
    return 204;
  }

  # A path that names a file is that file or a 404, never the SPA: a stale bundle must fail as missing.
  location ~ \.[A-Za-z0-9]+$ {
    try_files $uri =404;
  }

  # Routes with a parameter in the path are not prerendered; the SPA fallback renders them in the browser.
  location / {
    try_files $uri $uri/index.html /__spa-fallback.html;
  }
}
