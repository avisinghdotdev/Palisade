    "/api/shop/carts/{cart_id}/checkout": {
      "post": {
        "tags": [
          "shop"
        ],
        "summary": "Place Order",
        "description": "Pay for the cart from its wallet; calling again returns the order already placed.",
        "operationId": "checkout",
        "parameters": [
          {
            "name": "cart_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Cart Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
