    "/api/shop/wallets/link": {
      "post": {
        "tags": [
          "wallets"
        ],
        "summary": "Start Wallet Link",
        "description": "Begin saving the buyer's PayPal wallet; send the buyer to the approve URL.",
        "operationId": "start_wallet_link",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkStart"
                }
              }
            }
          }
        }
      }
    },
    "/api/shop/wallets/confirm": {
      "post": {
        "tags": [
          "wallets"
        ],
        "summary": "Confirm Wallet Link",
        "description": "Finish saving the wallet once the buyer has returned from PayPal.\n\nA 422 means PayPal refused the setup token (unknown, unapproved, or already used); a 502\nmeans PayPal failed to answer.",
        "operationId": "confirm_wallet_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
