    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "What every platform probe calls: the process answers.\n\nIt reads nothing, so a database outage neither restarts the replica nor takes it out of rotation.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Ready",
        "description": "Whether this replica reaches its database; the release workflow checks it after a deploy.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "The database did not answer in time."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cart": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid",
            "title": "Wallet Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "checking_out",
              "completed"
            ],
            "title": "Status"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "type": "object",
        "required": [
          "id",
          "wallet_id",
          "status",
          "lines",
          "total"
        ],
        "title": "Cart"
      },
      "CartLine": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit_price": {
            "$ref": "#/components/schemas/Money"
          },
          "line_total": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "size",
          "quantity",
          "brand",
          "name",
          "unit_price",
          "line_total"
        ],
        "title": "CartLine"
      },
      "CartWallet": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "format": "uuid",
            "title": "Wallet Id"
          }
        },
        "type": "object",
        "required": [
          "wallet_id"
        ],
        "title": "CartWallet"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "JsonValue": {},
      "LineChange": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "quantity": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "size",
          "quantity"
        ],
        "title": "LineChange",
        "description": "A product in a size and the quantity wanted; 0 removes the line."
      },
      "LinkConfirmation": {
        "properties": {
          "setup_token_id": {
            "type": "string",
            "title": "Setup Token Id"
          }
        },
        "type": "object",
        "required": [
          "setup_token_id"
        ],
        "title": "LinkConfirmation"
      },
      "LinkStart": {
        "properties": {
          "setup_token_id": {
            "type": "string",
            "title": "Setup Token Id"
          },
          "approve_url": {
            "type": "string",
            "title": "Approve Url"
          }
        },
        "type": "object",
        "required": [
          "setup_token_id",
          "approve_url"
        ],
        "title": "LinkStart",
        "description": "Where to send the buyer to approve the link, and the token to confirm with afterwards."
      },
      "Money": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "currency_code": {
            "type": "string",
            "const": "USD",
            "title": "Currency Code"
          }
        },
        "type": "object",
        "required": [
          "value",
          "currency_code"
        ],
        "title": "Money",
        "description": "An amount in PayPal's shape, so an order line can carry it unchanged."
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "number": {
            "type": "string",
            "title": "Number"
          },
          "cart_id": {
            "type": "string",
            "format": "uuid",
            "title": "Cart Id"
          },
          "channel": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ],
            "title": "Channel"
          },
          "status": {
            "type": "string",
            "enum": [
              "creating",
              "declined",
              "failed",
              "authorized",
              "capture_pending",
              "captured",
              "voided",
              "refunded",
              "reversed"
            ],
            "title": "Status"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "custom_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Id"
          },
          "paypal_order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paypal Order Id"
          },
          "authorization_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization Id"
          },
          "authorization_expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization Expires At"
          },
          "capture_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Id"
          },
          "payer_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Email"
          },
          "wallet_email": {
            "type": "string",
            "title": "Wallet Email"
          },
          "wallet_demo": {
            "type": "boolean",
            "title": "Wallet Demo"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/OrderEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/PayPalCall"
            },
            "type": "array",
            "title": "Calls"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "cart_id",
          "channel",
          "status",
          "total",
          "custom_id",
