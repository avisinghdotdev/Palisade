{
  "openapi": "3.1.0",
  "info": {
    "title": "Palisade API",
    "version": "0.6.0"
  },
  "paths": {
    "/api/paypal/health": {
      "get": {
        "tags": [
          "paypal"
        ],
        "summary": "Paypal Health",
        "operationId": "paypal_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayPalHealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/paypal": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive Paypal Webhook",
        "description": "Accept a delivery once PayPal confirms its signature; a repeat delivery is a no-op.\n\nThe event is stored and its processing queued in one transaction before the 2xx that stops\nPayPal's retries. A 400 answers a signature PayPal rejects, and an error reaching PayPal or the\ndatabase surfaces as a 500 so PayPal delivers the event again later.",
        "operationId": "paypal_webhook",
        "parameters": [
          {
            "name": "paypal-transmission-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Id"
            }
          },
          {
            "name": "paypal-transmission-time",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Time"
            }
          },
          {
            "name": "paypal-transmission-sig",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Sig"
            }
          },
          {
            "name": "paypal-cert-url",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paypal-Cert-Url"
            }
          },
          {
            "name": "paypal-auth-algo",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paypal-Auth-Algo"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/events": {
      "get": {
        "tags": [
          "webhooks"
        ],
        "summary": "Webhook Events",
        "operationId": "webhook_events",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReceivedEvent"
                  },
                  "type": "array",
                  "title": "Response Webhook Events"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/events/{event_id}/replay": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Replay Webhook Event",
        "description": "Queue a stored event for processing again, as if it had just arrived.",
        "operationId": "replay_webhook_event",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuedJob"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shop/products": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Products",
        "operationId": "products",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  },
                  "type": "array",
                  "title": "Response Products"
                }
              }
            }
          }
        }
      }
    },
    "/api/shop/products/{product_id}": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Get Product",
        "operationId": "product",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "JsonValue": {},
      "Money": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "currency_code": {
            "type": "string",
            "const": "USD",
            "title": "Currency Code"
          }
        },
        "type": "object",
        "required": [
          "value",
          "currency_code"
        ],
        "title": "Money",
        "description": "An amount in PayPal's shape, so an order line can carry it unchanged."
      },
      "PayPalHealth": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "app_id": {
            "type": "string",
            "title": "App Id"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "token_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Token Expires At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "app_id",
          "scopes",
          "token_expires_at"
        ],
        "title": "PayPalHealth"
      },
      "PhotoCredit": {
        "properties": {
          "by": {
            "type": "string",
            "title": "By"
          },
          "by_url": {
            "type": "string",
            "title": "By Url"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "by",
          "by_url",
          "url"
        ],
        "title": "PhotoCredit",
        "description": "Who took the product photo and where it lives on Unsplash."
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "sizes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sizes"
          },
          "image_path": {
            "type": "string",
            "title": "Image Path"
          },
          "photo": {
            "$ref": "#/components/schemas/PhotoCredit"
          }
        },
        "type": "object",
        "required": [
          "id",
          "brand",
          "name",
          "category",
          "description",
          "price",
          "sizes",
          "image_path",
          "photo"
        ],
        "title": "Product"
      },
      "QueuedJob": {
        "properties": {
          "job_id": {
            "type": "integer",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "QueuedJob"
      },
      "ReceivedEvent": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/WebhookEvent"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          }
        },
        "type": "object",
        "required": [
          "event",
          "received_at",
          "processed_at"
        ],
        "title": "ReceivedEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WebhookEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "create_time": {
            "type": "string",
            "format": "date-time",
            "title": "Create Time"
          },
          "resource_type": {
            "type": "string",
            "title": "Resource Type"
          },
          "resource_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Version"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "resource": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Resource"
          }
        },
        "type": "object",
        "required": [
          "id",
          "event_type",
          "create_time",
          "resource_type",
          "summary",
          "resource"
        ],
        "title": "WebhookEvent"
      }
    }
  }
}
