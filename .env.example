# PayPal sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Second sandbox REST app on the business account that plays the demo buyer
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=
# Webhook on the seller app that delivers to /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Anthropic API key
ANTHROPIC_API_KEY=
# Cloudflare user API token
CLOUDFLARE_API_TOKEN=
# PostgreSQL on PlanetScale
DATABASE_URL=
# AG Studio licence key for the merchant console's analytics dashboard, in double quotes
# (the key contains spaces)
AG_STUDIO_LICENSE_KEY=""
# The site's origin as the buyer's browser reaches it, for PayPal's return and cancel URLs
PUBLIC_ORIGIN=http://127.0.0.1:8080
# The PayPal sandbox account whose linked wallet is the shop's default buyer
DEMO_BUYER_EMAIL=buyer.business@palisade.example.com
# Ed25519 private keys as base64 of 32 random bytes, one per signer: the in-page shopper agent,
# the MCP agent, and the demo signer that approves a mandate in place of a passkey
SHOPPER_AGENT_KEY=
MCP_AGENT_KEY=
DEMO_SIGNER_KEY=
