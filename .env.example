# PayPal sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Second sandbox REST app on the business account that plays the demo buyer; it files disputes.
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=
# Webhook on the seller app that delivers to /api/webhooks/paypal; its id verifies each delivery.
PAYPAL_WEBHOOK_ID=
# Anthropic API key for the buyer agent, the fit score and the evidence narrative.
ANTHROPIC_API_KEY=
# Cloudflare user API token scoped to the avisingh.dev zone; read by the `cf` CLI, never by the app.
CLOUDFLARE_API_TOKEN=
